{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graphghan.milo.cat/schema/progress.schema.json",
  "title": "Graphghan progress document, schema 1",
  "type": "object",
  "required": ["schema", "pattern_id", "chart_id", "cursor", "events"],
  "properties": {
    "schema": { "const": 1 },
    "pattern_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "chart_id": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
    "pattern_version": { "type": "string" },
    "cursor": { "$ref": "#/$defs/cursor" },
    "started": { "type": "string", "format": "date-time" },
    "finished": { "type": ["string", "null"], "format": "date-time" },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["t", "row", "run", "kind"],
        "properties": {
          "t": { "type": "string", "format": "date-time" },
          "row": { "type": "integer", "minimum": 1 },
          "run": { "type": "integer", "minimum": 0 },
          "stitch": { "type": "integer", "minimum": 0 },
          "kind": { "enum": ["advance", "back", "jump"] }
        }
      }
    }
  },
  "$defs": {
    "cursor": {
      "type": "object",
      "required": ["row", "run"],
      "properties": {
        "row": { "type": "integer", "minimum": 1 },
        "run": { "type": "integer", "minimum": 0 },
        "stitch": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
