s, tapestry style. The side strips add about four gold runs to every other row.\nLettering rows are cream and charcoal only across the panel. Carry charcoal under the cream between letters, or use a bobbin per word.\nScene rows are cream sky with charcoal stones and the gold moon; the hill rows are long green runs, the easiest in the blanket."}],"stats":{"stitches":34776,"size_in":[54.0,46.0],"counts":{"C":17371,"K":2763,"G":8744,"P":90,"Y":5808},"single_stitch_runs":{"C":188,"K":35,"G":496,"P":10,"Y":304},"color_changes_per_row":{"mean":28.9,"max":94,"per_row":[0,0,2,2,52,52,94,50,54,54,50,94,52,52,2,2,12,14,14,14,16,16,18,14,16,20,22,22,24,24,24,24,24,30,30,30,30,28,28,24,24,28,28,30,22,18,18,14,14,18,18,18,18,18,18,14,12,16,16,16,18,20,20,48,42,62,68,58,56,60,66,40,44,22,22,22,16,16,16,12,12,16,16,46,36,54,58,44,44,54,54,32,46,18,18,14,12,16,16,16,22,26,24,30,28,40,40,36,38,40,42,24,28,18,18,16,16,16,16,12,22,28,28,48,42,62,58,48,48,52,56,38,46,16,16,12,12,16,16,36,20,20,20,18,22,26,26,26,26,22,30,26,26,22,34,26,34,22,22,18,18,22,16,16,14,14,14,12,2,2,52,52,94,50,54,54,50,94,52,52,2,2,0,0]},"yards_est":{"C":1638,"K":261,"G":824,"P":8,"Y":548},"skeins_364yd":{"C":4.5,"K":0.7,"G":2.3,"P":0.0,"Y":1.5}},"ext":{"graphghan":{"report":{"panel":[18,20,171,164],"scene":[18,20,171,56],"text":[[35,59,153,76],[46,79,142,96],[66,99,123,116],[43,119,145,136]],"text_bottom":136,"thistles":[[22,139,39,162],[150,139,167,162]],"dragonfly":[82,140,107,162]}}}}
